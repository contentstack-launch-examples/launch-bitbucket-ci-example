# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: region the Contentstack CLI should target
# One of: AWS-NA, AWS-EU, AWS-AU, AZURE-NA, AZURE-EU, GCP-NA, GCP-EU
CONTENTSTACK_REGION="AWS-NA"

# Required: Contentstack account credentials used to log in via the CLI (csdx auth:login)
CS_USERNAME="your_email@example.com"
CS_PASSWORD="your_password"

# Optional: base32 TOTP secret, only needed if the account has MFA enabled
# CONTENTSTACK_MFA_SECRET="your_totp_secret"

# Required: Launch project, environment, and organization
PROJECT_UID="your_project_uid"
ENVIRONMENT_UID="your_environment_uid"
ORGANIZATION_UID="your_organization_uid"
